{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "cd ilha-do-tavares && pnpm run build:vercel",
  "outputDirectory": "ilha-do-tavares/dist/public",
  "installCommand": "cd ilha-do-tavares && pnpm install",
  "framework": "vite",
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)\\.(ico|png|jpg|jpeg|svg|webp|woff2|woff|pdf)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "rewrites": [{ "source": "/(.*)", "destination": "/index.html" }]
}

