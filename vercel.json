{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "cd ilha-do-tavares && pnpm run build:vercel",
  "outputDirectory": "ilha-do-tavares/dist/public",
  "installCommand": "cd ilha-do-tavares && pnpm install",
  "framework": "vite",
  "rewrites": [{ "source": "/(.*)", "destination": "/index.html" }]
}
